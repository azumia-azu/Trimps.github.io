{
  "name": "trimps-workspace",
  "private": true,
  "workspaces": [
    "packages/trimps-engine",
    "packages/trimps-tui"
  ],
  "scripts": {
    "trimps-headless": "npm --workspace @trimps/engine run trimps-headless --",
    "trimps-tui": "bun --cwd packages/trimps-tui src/cli.js",
    "trimps-tui:bun": "bun --cwd packages/trimps-tui src/cli.js",
    "start:tui": "bun --cwd packages/trimps-tui src/cli.js run"
  }
}
